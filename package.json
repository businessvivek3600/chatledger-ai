{
  "name": "nexaflow-ai",
  "version": "1.0.0",
  "private": true,
  "description": "NexaFlow AI - Multi-Tenant WhatsApp-First AI Operations & Lead Management SaaS",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces",
    "dev:backend": "npm run dev --workspace=apps/backend",
    "dev:web": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "prisma:generate": "npm run prisma:generate --workspace=apps/backend",
    "prisma:migrate": "npm run prisma:migrate --workspace=apps/backend",
    "prisma:seed": "npm run prisma:seed --workspace=apps/backend"
  },
  "keywords": [
    "whatsapp",
    "saas",
    "ai",
    "crm",
    "multi-tenant",
    "rag"
  ],
  "author": "NexaFlow AI Engineering Team",
  "license": "UNLICENSED"
}
